# ==========================================
# AI Lead Qualifier v2.0 — Environment Config
# ==========================================

# Database (PostgreSQL)
DATABASE_URL=postgresql://leadqualifier:leadqualifier@localhost:5432/leadqualifier?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# App
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
APP_NAME=AI Lead Qualifier
LOG_LEVEL=info
LOG_SLOW_QUERIES=true

# Security (generate strong random values)
JWT_SECRET=change-this-to-a-64-character-random-string-minimum-required-length
ENCRYPTION_KEY=change-this-to-a-32-byte-hex-string-for-aes-256-gcm-encryption

# AI / OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o
OPENAI_FALLBACK_MODEL=gpt-4o-mini
AI_RATE_LIMIT_MAX=100
AI_RATE_LIMIT_WINDOW=3600

# Email / SMTP (Gmail example — use App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
EMAIL_FROM=noreply@yourdomain.com

# Stripe Billing
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_PRICE_STARTER=price_your_starter_price_id
STRIPE_PRICE_PRO=price_your_pro_price_id
STRIPE_PRICE_ENTERPRISE=price_your_enterprise_price_id

# Enrichment APIs (optional but recommended)
HUNTER_API_KEY=
CLEARBIT_API_KEY=
PROXYCURL_API_KEY=

# Salesforce OAuth (optional)
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=https://your-app.com/api/auth/salesforce/callback
